# Development/test image. Production uses ./Dockerfile (deployed by Railway) --
# keep the two separate. Source is bind-mounted over /app by docker-compose.yml;
# the COPY below only exists so the image also works standalone.
FROM ruby:3.4.10-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libpq-dev libyaml-dev pkg-config postgresql-client curl && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives

WORKDIR /app

# All gem groups (development + test included); no BUNDLE_WITHOUT.
ENV BUNDLE_PATH=/usr/local/bundle

COPY Gemfile Gemfile.lock .ruby-version ./
RUN bundle install

COPY . .

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
