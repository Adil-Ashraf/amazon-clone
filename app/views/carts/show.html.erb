<% content_for :title, "Your Cart" %>

<div class="page py-8 lg:py-12">
  <h1 class="page-title">Your Cart</h1>

  <div id="cart_flash" class="mt-4 empty:hidden" aria-live="polite"></div>

  <div id="cart_items" class="mt-6 lg:mt-8">
    <%= render "cart", cart: @cart, cart_items: @cart_items %>
  </div>

  <%= render "saved_items", saved_items: @saved_items %>
</div>
