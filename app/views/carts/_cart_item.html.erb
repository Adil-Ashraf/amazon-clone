<div id="<%= dom_id(cart_item) %>" class="flex flex-wrap items-center gap-4 py-4">
  <%= link_to product_path(cart_item.product), class: "shrink-0" do %>
    <div class="w-20 h-20 bg-gray-200 rounded overflow-hidden">
      <%= product_image_tag cart_item.product, alt: cart_item.product.name %>
    </div>
  <% end %>

  <div class="flex-1 min-w-[140px]">
    <%= link_to cart_item.product.name, product_path(cart_item.product), class: "font-medium text-gray-900 hover:underline" %>
    <p class="text-sm text-gray-500"><%= format_price_cents(cart_item.product.price_cents) %> each</p>

    <%= form_with url: cart_item_path(cart_item), method: :patch, class: "flex items-center gap-2 mt-2" do |f| %>
      <%= f.label :quantity, "Qty", class: "text-sm text-gray-500" %>
      <%= f.number_field :quantity, value: cart_item.quantity, min: 1, max: cart_item.product.stock,
            class: "w-16 px-2 py-1 text-sm #{input_classes}" %>
      <%= f.submit "Update", data: { turbo_submits_with: "Updating..." },
            class: "text-sm bg-gray-200 hover:bg-gray-300 px-3 py-1 rounded cursor-pointer" %>
    <% end %>
  </div>

  <div class="text-right shrink-0 ml-auto sm:ml-0">
    <p class="font-semibold text-gray-900"><%= format_price_cents(cart_item.product.price_cents * cart_item.quantity) %></p>
    <%= button_to "Remove", cart_item_path(cart_item), method: :delete,
          data: { turbo_submits_with: "Removing..." },
          class: "text-sm text-red-600 hover:underline bg-transparent border-0 p-0 mt-2 cursor-pointer" %>
  </div>
</div>
