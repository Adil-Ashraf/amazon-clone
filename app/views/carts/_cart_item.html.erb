<%# locals: (cart_item:) %>
<% product = cart_item.product %>
<li id="<%= dom_id(cart_item) %>" class="flex gap-4 py-5 sm:gap-5 sm:py-6">
  <%= link_to product_path(product), class: "block size-24 shrink-0 overflow-hidden rounded-xl bg-subtle sm:size-28", tabindex: -1, "aria-hidden": "true" do %>
    <%= product_image_tag product, sizes: :thumb %>
  <% end %>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <%= link_to product.name, product_path(product), class: "line-clamp-2 rounded text-[15px] font-semibold text-ink hover:text-brand-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" %>
        <p class="mt-1 text-sm text-muted"><%= format_price_cents(product.price_cents) %> each</p>
        <% if product.low_stock? %><div class="mt-2"><%= stock_badge(product) %></div><% end %>
      </div>
      <p class="price shrink-0 text-base"><%= format_price_cents(product.price_cents * cart_item.quantity) %></p>
    </div>

    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-3">
      <div class="inline-flex items-center rounded-btn border border-line" role="group" aria-label="Quantity for <%= product.name %>">
        <%= button_to cart_item_path(cart_item), method: :patch, params: { quantity: cart_item.quantity - 1 },
              class: "icon-btn rounded-l-btn rounded-r-none",
              "aria-label": (cart_item.quantity == 1 ? "Remove #{product.name}" : "Decrease quantity") do %>
          <%= icon(cart_item.quantity == 1 ? :trash : :minus, css_class: "size-4") %>
        <% end %>
        <span class="w-9 text-center text-[15px] font-semibold tabular-nums" aria-live="polite"><%= cart_item.quantity %></span>
        <%= button_to cart_item_path(cart_item), method: :patch, params: { quantity: cart_item.quantity + 1 },
              disabled: cart_item.quantity >= product.stock,
              class: "icon-btn rounded-l-none rounded-r-btn", "aria-label": "Increase quantity" do %>
          <%= icon(:plus, css_class: "size-4") %>
        <% end %>
      </div>

      <div class="ml-auto flex items-center">
        <%= button_to "Save for later", save_for_later_cart_item_path(cart_item), method: :post,
              data: { turbo_submits_with: "Saving…" }, class: "btn-tertiary min-h-11 px-3 text-sm font-medium" %>
        <%= button_to "Remove", cart_item_path(cart_item), method: :delete,
              data: { turbo_submits_with: "Removing…" }, class: "btn-danger min-h-11 px-3 text-sm font-medium",
              "aria-label": "Remove #{product.name} from cart" %>
      </div>
    </div>
  </div>
</li>
