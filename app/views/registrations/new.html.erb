<% content_for :title, "Sign Up" %>

<div class="max-w-sm mx-auto bg-white rounded shadow p-6">
  <h1 class="text-2xl font-semibold mb-4">Create Account</h1>

  <%= render "shared/error_messages", object: @user %>

  <%= form_with model: @user, url: registration_path, method: :post do |f| %>
    <div class="mb-4">
      <%= f.label :name, class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, required: true, autofocus: true,
            class: "w-full rounded border-gray-300 px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, required: true,
            class: "w-full rounded border-gray-300 px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true, minlength: 8,
            class: "w-full rounded border-gray-300 px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password_confirmation, required: true, minlength: 8,
            class: "w-full rounded border-gray-300 px-3 py-2" %>
    </div>

    <%= f.submit "Create Account", data: { turbo_submits_with: "Creating Account..." },
          class: "w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold py-2 rounded cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-sm text-gray-600">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
