<% content_for :title, "Create account" %>

<%= render layout: "shared/auth_shell", locals: { showcase: @showcase } do %>
  <h1 class="page-title">Create your account</h1>
  <p class="mt-2 text-[15px] text-muted">Save favourites, check out faster and track every order.</p>

  <div class="mt-8">
    <%= render "shared/error_messages", object: @user %>
  </div>

  <%= form_with model: @user, url: registration_path, method: :post, class: "space-y-5" do |f| %>
    <div>
      <%= f.label :name, "Name", class: "label" %>
      <%= f.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "input",
            "aria-invalid": (@user.errors[:name].any? ? "true" : nil) %>
    </div>
    <div>
      <%= f.label :email, "Email", class: "label" %>
      <%= f.email_field :email, required: true, autocomplete: "email", class: "input",
            "aria-invalid": (@user.errors[:email].any? ? "true" : nil) %>
    </div>
    <div>
      <%= f.label :password, "Password", class: "label" %>
      <%= f.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "input",
            "aria-describedby": "password_hint", "aria-invalid": (@user.errors[:password].any? ? "true" : nil) %>
      <p id="password_hint" class="mt-1.5 text-xs text-muted">At least 8 characters.</p>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "label" %>
      <%= f.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password", class: "input",
            "aria-invalid": (@user.errors[:password_confirmation].any? ? "true" : nil) %>
    </div>
    <%= f.submit "Create account", data: { turbo_submits_with: "Creating account…" }, class: "btn-primary btn-lg w-full" %>
  <% end %>

  <p class="mt-8 text-center text-[15px] text-muted">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "link" %>
  </p>
<% end %>
