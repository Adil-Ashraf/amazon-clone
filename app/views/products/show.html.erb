<% content_for :title, @product.name %>

<nav class="text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
  <%= link_to "Home", root_path, class: "hover:underline" %>
  <span class="mx-1">/</span>
  <%= link_to @product.category.name, products_path(category: @product.category.slug), class: "hover:underline" %>
  <span class="mx-1">/</span>
  <span class="text-gray-700"><%= @product.name %></span>
</nav>

<div class="grid md:grid-cols-3 gap-8">
  <div class="md:col-span-2">
    <div class="relative aspect-square bg-gray-200 rounded-lg overflow-hidden border border-gray-200">
      <%= product_image_tag @product, alt: @product.name, class: "w-full h-full object-cover" %>
      <%# Softens any stray Flickr attribution watermark baked into the bottom of the photo. %>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/40 to-transparent"></div>
    </div>

    <div class="flex gap-2 mt-3">
      <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-md overflow-hidden border-2 border-amber-400">
        <%= product_image_tag @product, alt: "", class: "w-full h-full object-cover" %>
      </div>
      <% 2.times do %>
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-md overflow-hidden border border-gray-200 opacity-70">
          <%= image_tag product_image_fallback_data_uri(@product), alt: "", class: "w-full h-full object-cover" %>
        </div>
      <% end %>
    </div>
  </div>

  <div>
    <p class="text-xs text-gray-500 uppercase tracking-wide mb-1"><%= @product.category.name %></p>
    <h1 class="text-2xl font-semibold text-gray-900 mb-3"><%= @product.name %></h1>
    <p class="text-gray-700 leading-relaxed whitespace-pre-line"><%= @product.description %></p>

    <div class="border border-gray-300 rounded-lg shadow-sm p-4 mt-6 bg-white">
      <p class="text-3xl font-bold text-gray-900 mb-2"><%= format_price_cents(@product.price_cents) %></p>
      <div class="mb-3"><%= stock_badge(@product) %></div>

      <% unless @product.out_of_stock? %>
        <p class="text-sm text-gray-600 mb-4">
          <span class="font-semibold text-gray-900">FREE delivery</span> <%= estimated_delivery_range %>
        </p>
      <% end %>

      <% if @product.out_of_stock? %>
        <button type="button" disabled
          class="w-full bg-gray-300 text-gray-500 font-semibold px-6 py-3 rounded cursor-not-allowed">
          Out of Stock
        </button>
      <% else %>
        <%= form_with url: cart_items_path, method: :post, class: "space-y-3" do |f| %>
          <%= f.hidden_field :product_id, value: @product.id %>
          <div>
            <%= f.label :quantity, "Qty", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="inline-flex items-center border border-gray-300 rounded"
                 data-controller="quantity-stepper" data-quantity-stepper-max-value="<%= [ @product.stock, 10 ].min %>">
              <button type="button" data-quantity-stepper-target="decrement" data-action="quantity-stepper#decrement"
                class="px-3 py-2 text-gray-600 hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
                aria-label="Decrease quantity">&minus;</button>
              <%= f.number_field :quantity, value: 1, min: 1, max: [ @product.stock, 10 ].min,
                    data: { quantity_stepper_target: "input" },
                    class: "w-12 text-center border-0 bg-white text-gray-900 py-2 focus:ring-0" %>
              <button type="button" data-quantity-stepper-target="increment" data-action="quantity-stepper#increment"
                class="px-3 py-2 text-gray-600 hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent"
                aria-label="Increase quantity">&plus;</button>
            </div>
          </div>
          <%= f.submit "Add to Cart", data: { turbo_submits_with: "Adding..." },
                class: "w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold px-6 py-3 rounded cursor-pointer" %>
        <% end %>
      <% end %>

      <div id="add_to_cart_status" class="mt-3"></div>
    </div>
  </div>
</div>
