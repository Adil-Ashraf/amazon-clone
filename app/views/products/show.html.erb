<% content_for :title, @product.name %>
<%
  card_state = { bag_quantities: @bag_quantities, wishlist_ids: @wishlist_ids }
  max_quantity = [ @product.stock, 10 ].min
  free_shipping = @product.price_cents >= Order::FREE_SHIPPING_THRESHOLD_CENTS
%>

<div class="page py-6 lg:py-10 <%= 'pb-28 md:pb-10' unless @product.out_of_stock? %>">
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><%= link_to "Home", root_path, class: "quiet-link text-muted" %></li>
      <li aria-hidden="true"><%= icon(:chevron_right, css_class: "size-3.5") %></li>
      <li><%= link_to @product.category.name, products_path(category: @product.category.slug), class: "quiet-link text-muted" %></li>
      <li aria-hidden="true"><%= icon(:chevron_right, css_class: "size-3.5") %></li>
      <li class="max-w-[16rem] truncate text-ink" aria-current="page"><%= @product.name %></li>
    </ol>
  </nav>

  <div class="grid gap-8 md:grid-cols-2 md:gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <%# Gallery: one verified photo per product (docs/DESIGN.md), so one large image. %>
    <div class="md:sticky md:top-24 md:self-start lg:top-40">
      <div class="relative aspect-square overflow-hidden rounded-2xl border border-line bg-subtle">
        <%= product_image_tag @product, loading: "eager", sizes: :detail %>
        <% if @product.on_sale? %>
          <div class="absolute left-4 top-4"><%= discount_badge(@product, size: :md) %></div>
        <% end %>
      </div>
    </div>

    <div class="min-w-0">
      <%= link_to @product.category.name, products_path(category: @product.category.slug), class: "eyebrow rounded hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" %>
      <h1 class="page-title mt-3"><%= @product.name %></h1>
      <div class="mt-3"><%= rating_summary(@product, size: :lg, link: "#reviews") %></div>

      <div class="mt-6 border-t border-divider pt-6">
        <%= price_tag(@product, size: :lg) %>
        <% if @product.on_sale? %>
          <p class="mt-2 text-sm font-medium text-brand-strong">
            You save <%= format_price_cents(@product.compare_at_price_cents - @product.price_cents) %> (<%= @product.discount_percent %>%)
          </p>
        <% end %>
        <div class="mt-4"><%= stock_badge(@product) %></div>
      </div>

      <p class="mt-6 text-base leading-relaxed text-muted"><%= @product.description %></p>

      <div class="mt-8 rounded-2xl border border-line bg-surface p-5 sm:p-6">
        <% if @product.out_of_stock? %>
          <p class="text-[15px] font-medium">This item is sold out.</p>
          <p class="mt-1 text-sm text-muted">Save it to your wishlist and check back soon.</p>
          <div class="mt-5 flex gap-3">
            <button type="button" disabled class="btn-primary btn-lg flex-1">Sold out</button>
            <%= render "products/wishlist_toggle", product: @product, wishlist_item_id: @wishlist_ids[@product.id], bordered: true %>
          </div>
        <% else %>
          <%= form_with url: cart_items_path, method: :post, id: "add_to_cart_form" do |f| %>
            <%= f.hidden_field :product_id, value: @product.id %>
            <div class="flex items-center justify-between gap-4">
              <%= f.label :quantity, "Quantity", class: "text-sm font-medium" %>
              <div class="inline-flex items-center rounded-btn border border-line"
                   data-controller="quantity-stepper" data-quantity-stepper-max-value="<%= max_quantity %>">
                <button type="button" data-quantity-stepper-target="decrement" data-action="quantity-stepper#decrement"
                        class="icon-btn rounded-l-btn rounded-r-none" aria-label="Decrease quantity"><%= icon(:minus, css_class: "size-4") %></button>
                <%= f.number_field :quantity, value: 1, min: 1, max: max_quantity,
                      data: { quantity_stepper_target: "input" },
                      class: "h-11 w-12 border-0 bg-transparent text-center text-[15px] font-semibold tabular-nums outline-none [appearance:textfield] focus:ring-0 [&::-webkit-inner-spin-button]:appearance-none" %>
                <button type="button" data-quantity-stepper-target="increment" data-action="quantity-stepper#increment"
                        class="icon-btn rounded-l-none rounded-r-btn" aria-label="Increase quantity"><%= icon(:plus, css_class: "size-4") %></button>
              </div>
            </div>

            <%= f.button type: "submit", data: { turbo_submits_with: "Adding…" }, class: "btn-primary btn-lg mt-5 w-full" do %>
              <%= icon(:cart, css_class: "size-5") %> Add to Cart
            <% end %>
          <% end %>
          <%# Outside the form above: the heart is its own button_to form, and
              forms can't nest. Buy Now joins the purchase form via form=. %>
          <div class="mt-3 flex gap-3">
            <button type="submit" form="add_to_cart_form" name="buy_now" value="1" data-turbo-submits-with="One moment…"
                    class="btn-secondary btn-lg flex-1">Buy Now</button>
            <%= render "products/wishlist_toggle", product: @product, wishlist_item_id: @wishlist_ids[@product.id], bordered: true %>
          </div>
          <% if @bag_quantities[@product.id] %>
            <p class="mt-4 flex items-center gap-2 text-sm text-muted">
              <%= icon(:check, css_class: "size-4 text-success", stroke_width: 2.25) %>
              <%= pluralize(@bag_quantities[@product.id], "unit") %> already in your <%= link_to "cart", cart_path, class: "link" %>
            </p>
          <% end %>
        <% end %>
        <div id="add_to_cart_status" class="mt-3" aria-live="polite"></div>
      </div>

      <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5">
        <% [ [ :truck, "Free delivery", free_shipping ? "This item ships free" : "On orders over #{format_price_cents(Order::FREE_SHIPPING_THRESHOLD_CENTS, trim: true)}" ],
             [ :returns, "Easy returns", "30 days from delivery" ],
             [ :lock, "Secure checkout", "Your connection is protected with HTTPS" ],
             [ :award, "Warranty", "1-year Aisle guarantee" ] ].each do |icon_name, title, body| %>
          <li class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-surface text-ink ring-1 ring-line"><%= icon(icon_name, css_class: "size-5", stroke_width: 1.5) %></span>
            <div class="text-sm">
              <p class="font-semibold"><%= title %></p>
              <p class="text-muted"><%= body %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <%# Details %>
  <div class="mt-16 lg:mt-24">
    <nav aria-label="Product details" class="sticky top-16 z-10 -mx-4 border-b border-line bg-bg/95 px-4 backdrop-blur md:-mx-6 md:px-6 lg:top-[126px] lg:mx-0 lg:px-0">
      <ul class="flex gap-8">
        <% [ [ "Description", "description" ], [ "Specifications", "specifications" ], [ "Reviews (#{@product.reviews_count})", "reviews" ] ].each do |label, anchor| %>
          <li><a href="#<%= anchor %>" class="flex h-12 items-center text-[15px] font-medium text-muted transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"><%= label %></a></li>
        <% end %>
      </ul>
    </nav>

    <div class="grid gap-12 pt-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <section id="description" class="scroll-mt-48" aria-labelledby="description_heading">
        <h2 id="description_heading" class="h3">Description</h2>
        <p class="mt-4 max-w-prose text-base leading-relaxed text-muted"><%= @product.description %></p>
      </section>

      <section id="specifications" class="scroll-mt-48" aria-labelledby="specifications_heading">
        <h2 id="specifications_heading" class="h3">Specifications</h2>
        <dl class="mt-4 divide-y divide-divider rounded-2xl border border-line bg-surface text-sm">
          <% [ [ "Category", @product.category.name ],
               [ "Item number", "AM-#{@product.id.to_s.rjust(6, '0')}" ],
               [ "Availability", @product.out_of_stock? ? "Sold out" : "#{@product.stock} in stock" ],
               [ "Shipping", free_shipping ? "Free" : "#{format_price_cents(Order::SHIPPING_FEE_CENTS)}, free over #{format_price_cents(Order::FREE_SHIPPING_THRESHOLD_CENTS, trim: true)}" ],
               [ "Returns", "30 days" ],
               [ "Listed", @product.created_at.strftime("%B %Y") ] ].each do |term, value| %>
            <div class="grid grid-cols-[9rem_1fr] gap-4 px-5 py-3.5">
              <dt class="text-muted"><%= term %></dt>
              <dd class="font-medium text-ink"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      </section>
    </div>

    <%= render "products/reviews", product: @product, reviews: @reviews, rating_counts: @rating_counts, can_review: @can_review %>
  </div>

  <% if @related.any? %>
    <section class="mt-16 lg:mt-24" aria-labelledby="related_heading">
      <%= render "shared/section_heading", id: "related_heading", title: "You may also like",
            link_label: "More in #{@product.category.name}", link_path: products_path(category: @product.category.slug) %>
      <%= render "products/grid", products: @related, **card_state %>
    </section>
  <% end %>

  <% if @recently_viewed.any? %>
    <section class="mt-16 lg:mt-24" aria-labelledby="recent_heading">
      <%= render "shared/section_heading", id: "recent_heading", title: "Recently viewed" %>
      <%= render "products/grid", products: @recently_viewed, **card_state %>
    </section>
  <% end %>
</div>

<%# Mobile: keep the main action in reach while reading the page. %>
<% unless @product.out_of_stock? %>
  <div class="sticky-action-bar fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:hidden">
    <div class="flex items-center gap-4">
      <div class="min-w-0 flex-1">
        <p class="truncate text-xs text-muted"><%= @product.name %></p>
        <p class="price text-lg"><%= format_price_cents(@product.price_cents) %></p>
      </div>
      <button type="submit" form="add_to_cart_form" class="btn-primary btn-lg" data-turbo-submits-with="Adding…">Add to Cart</button>
    </div>
  </div>
<% end %>
