<%
  heading = if @query.present?
    "Results for “#{@query}”"
  else
    @selected_category&.name || "All products"
  end
%>
<% content_for :title, heading %>

<%# The category chips live INSIDE this frame -- they must re-render on every
    category click alongside the grid, atomically, from the same response.
    Previously they sat outside the frame as a sibling, so a Turbo-Frame-scoped
    category click only swapped the grid; the chips' server-rendered
    active-state class (comparing @selected_category against each category)
    never got a chance to re-run, so the highlight stayed frozen at whatever it
    was on the last full page load. %>
<%= turbo_frame_tag "products_results", data: { turbo_action: "advance" } do %>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h1 class="font-display text-4xl leading-tight"><%= heading %></h1>
    <% if @pagy.count.positive? %>
      <p class="text-sm text-muted tabular-nums">
        Showing <%= @pagy.from %>&ndash;<%= @pagy.to %> of <%= @pagy.count %>
      </p>
    <% end %>
  </div>

  <div class="mt-6 mb-8 flex flex-col gap-4 sm:flex-row sm:items-center">
    <nav aria-label="Categories" class="-mx-4 px-4 sm:mx-0 sm:px-0 flex-1 min-w-0 overflow-x-auto">
      <ul class="flex gap-2 pb-1">
        <li class="shrink-0">
          <%= link_to "All", products_path(query: @query.presence, sort: @sort_param),
                "aria-current": (@selected_category ? nil : "page"),
                class: "chip whitespace-nowrap #{'chip-active' unless @selected_category}" %>
        </li>
        <% @categories.each do |category| %>
          <% active = @selected_category == category %>
          <li class="shrink-0">
            <%= link_to products_path(category: category.slug, query: @query.presence, sort: @sort_param),
                  "aria-current": (active ? "page" : nil),
                  class: "chip gap-2 whitespace-nowrap #{'chip-active' if active}" do %>
              <%= category_icon(category, css_class: "w-4 h-4 shrink-0") %>
              <%= category.name %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>

    <%= form_with url: products_path, method: :get,
          data: { controller: "auto-submit", turbo_frame: "products_results" },
          class: "flex items-center gap-2 shrink-0" do |f| %>
      <%= hidden_field_tag :category, @selected_category&.slug, id: nil if @selected_category %>
      <%= hidden_field_tag :query, @query, id: nil if @query.present? %>
      <%= f.label :sort, "Sort", class: "text-sm text-muted" %>
      <%= f.select :sort,
            options_for_select(
              [ ([ "Relevance", "relevance" ] if @query.present?),
                [ "Name", "name" ],
                [ "Price: low to high", "price_asc" ],
                [ "Price: high to low", "price_desc" ],
                [ "Newest", "newest" ] ].compact,
              @sort),
            {},
            data: { action: "auto-submit#submit" },
            class: "input pr-8 text-sm" %>
      <noscript><%= f.submit "Apply", name: nil, class: "btn-secondary" %></noscript>
    <% end %>
  </div>

  <% if @products.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      <% @products.each do |product| %>
        <%= render "product_card", product: product, in_bag_quantity: @bag_quantities[product.id] %>
      <% end %>
    </div>
    <%= render "pagination", pagy: @pagy %>
  <% elsif @query.present? %>
    <%= render "shared/empty_state", icon: :search,
          title: "Nothing matches “#{@query}”",
          body: "Try a shorter or different word#{" or another category" if @selected_category}.",
          action_label: "Clear search",
          action_path: products_path(category: @selected_category&.slug) %>
  <% elsif @selected_category %>
    <%= render "shared/empty_state", icon: :grid,
          title: "Nothing in #{@selected_category.name} yet",
          body: "This category is empty right now.",
          action_label: "Browse all products",
          action_path: products_path %>
  <% else %>
    <%= render "shared/empty_state", icon: :grid,
          title: "No products yet",
          body: "The catalog is empty right now. Check back soon." %>
  <% end %>
<% end %>
