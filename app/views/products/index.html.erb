<%
  heading = if @query.present?
    "Results for “#{@query}”"
  elsif @selected_category
    @selected_category.name
  elsif @filters[:deals]
    "Deals"
  elsif @sort == "newest"
    "New arrivals"
  else
    "All products"
  end
  sort_options = [ ([ "Best match", "relevance" ] if @query.present?), [ "Featured", "featured" ],
                   [ "Price: low to high", "price_asc" ], [ "Price: high to low", "price_desc" ],
                   [ "Newest", "newest" ], [ "Top rated", "rating" ] ].compact
  # Removable chips for every filter the shopper set.
  active_filters = []
  active_filters << [ @selected_category.name, :category ] if @selected_category
  active_filters << [ "“#{@query}”", :query ] if @query.present?
  if @filters[:price_min] || @filters[:price_max]
    label = [ ("$#{@filters[:price_min]}" if @filters[:price_min]), ("$#{@filters[:price_max]}" if @filters[:price_max]) ]
    active_filters << [ (label.all? ? label.join(" – ") : (@filters[:price_min] ? "Over #{label[0]}" : "Under #{label[1]}")), [ :price_min, :price_max ] ]
  end
  active_filters << [ "In stock", :in_stock ] if @filters[:in_stock]
  active_filters << [ "On sale", :deals ] if @filters[:deals]
  active_filters << [ "#{@filters[:rating]}★ & up", :rating ] if @filters[:rating]
%>
<% content_for :title, heading %>

<%= turbo_frame_tag "products_results", data: { turbo_action: "advance" }, class: "page block py-6 lg:py-10" do %>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><%= link_to "Home", root_path, class: "quiet-link text-muted", data: { turbo_frame: "_top" } %></li>
      <li aria-hidden="true"><%= icon(:chevron_right, css_class: "size-3.5") %></li>
      <% if @selected_category %>
        <li><%= link_to "Shop", products_path, class: "quiet-link text-muted" %></li>
        <li aria-hidden="true"><%= icon(:chevron_right, css_class: "size-3.5") %></li>
      <% end %>
      <li class="text-ink" aria-current="page"><%= @selected_category ? @selected_category.name : "Shop" %></li>
    </ol>
  </nav>

  <div class="mb-6 lg:mb-8">
    <h1 class="page-title"><%= heading %></h1>
    <p id="results_summary" class="mt-2 text-[15px] text-muted tabular-nums">
      <%= pluralize(number_with_delimiter(@pagy.count), "product") %>
    </p>
  </div>

  <%# Filters: a drawer below lg, an always-open sidebar from lg up.
      One element for both, so there's only one form and one set of ids. %>
  <div data-controller="drawer" class="lg:grid lg:grid-cols-[248px_1fr] lg:gap-10">
    <div>
      <dialog id="filters" class="drawer drawer-left lg:static lg:block lg:h-auto lg:max-h-none lg:w-auto lg:bg-transparent lg:shadow-none"
              aria-label="Filters" data-drawer-target="dialog" data-action="click->drawer#closeOnBackdrop">
        <%= form_with url: products_path, method: :get, id: "filters_form",
              data: { controller: "auto-submit", auto_submit_media_value: "(min-width: 1024px)", action: "change->auto-submit#submit" },
              class: "flex h-full flex-col lg:sticky lg:top-40 lg:h-auto" do |f| %>
          <%= hidden_field_tag :query, @query, id: nil if @query.present? %>
          <%= hidden_field_tag :category, @selected_category.slug, id: nil if @selected_category %>
          <%= hidden_field_tag :sort, @listing_params[:sort], id: nil if @listing_params[:sort] %>
          <%= hidden_field_tag :view, @view, id: nil if @listing_params[:view] %>

          <h2 class="sr-only hidden lg:block">Filters</h2>
          <div class="flex h-16 shrink-0 items-center justify-between border-b border-divider px-5 lg:hidden">
            <h2 class="text-lg font-semibold">Filters</h2>
            <button type="button" class="icon-btn -mr-2" data-action="drawer#close" aria-label="Close filters" autofocus><%= icon(:close, css_class: "size-6") %></button>
          </div>

          <div class="flex-1 divide-y divide-divider overflow-y-auto px-5 lg:overflow-visible lg:px-0">
            <nav aria-label="Categories" class="pb-6 pt-5 lg:pt-0">
              <h3 class="mb-3 text-sm font-semibold">Categories</h3>
              <ul class="space-y-0.5">
                <% [ [ "All categories", nil ] ].concat(@categories.map { |c| [ c.name, c ] }).each do |label, category| %>
                  <% active = @selected_category == category %>
                  <li>
                    <%= link_to products_path(**@listing_params.except(:category), category: category&.slug),
                          "aria-current": (active ? "page" : nil),
                          class: "flex min-h-10 items-center justify-between rounded-lg px-3 text-[15px] transition-colors hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand #{active ? 'bg-surface font-semibold text-ink shadow-[inset_3px_0_0] shadow-brand' : 'text-muted hover:text-ink'}" do %>
                      <%= label %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </nav>

            <fieldset class="py-6">
              <legend class="mb-3 text-sm font-semibold">Price</legend>
              <div class="flex items-end gap-2">
                <div class="flex-1">
                  <%= f.label :price_min, "Min", class: "mb-1 block text-xs text-muted" %>
                  <div class="relative">
                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-muted">$</span>
                    <%= f.number_field :price_min, value: @filters[:price_min], min: 0, step: 1, inputmode: "numeric", placeholder: "0", class: "input h-11 pl-7 pr-2" %>
                  </div>
                </div>
                <span class="pb-3 text-muted" aria-hidden="true">–</span>
                <div class="flex-1">
                  <%= f.label :price_max, "Max", class: "mb-1 block text-xs text-muted" %>
                  <div class="relative">
                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-muted">$</span>
                    <%= f.number_field :price_max, value: @filters[:price_max], min: 0, step: 1, inputmode: "numeric", placeholder: "Any", class: "input h-11 pl-7 pr-2" %>
                  </div>
                </div>
              </div>
              <button type="submit" class="btn-secondary mt-3 hidden w-full border-line lg:inline-flex">Apply price</button>
            </fieldset>

            <fieldset class="py-6">
              <legend class="mb-3 text-sm font-semibold">Availability</legend>
              <% [ [ :in_stock, "In stock only" ], [ :deals, "On sale" ] ].each do |key, label| %>
                <label class="flex min-h-11 cursor-pointer items-center gap-3 text-[15px] text-ink">
                  <%= check_box_tag key, "1", @filters[key].present?, class: "size-[18px] cursor-pointer rounded accent-brand-strong" %>
                  <%= label %>
                </label>
              <% end %>
            </fieldset>

            <fieldset class="py-6">
              <legend class="mb-3 text-sm font-semibold">Customer rating</legend>
              <% [ [ nil, "Any rating" ], *ProductsController::RATING_FILTERS.map { |r| [ r, "#{r} stars & up" ] } ].each do |rating, label| %>
                <label class="flex min-h-11 cursor-pointer items-center gap-3 text-[15px] text-ink">
                  <%= radio_button_tag :rating, rating.to_s, @filters[:rating] == rating, id: "rating_#{rating || 'any'}", class: "size-[18px] cursor-pointer accent-brand-strong" %>
                  <% if rating %>
                    <%= rating_stars(rating, css_class: "size-4") %><span class="sr-only"><%= label %></span><span aria-hidden="true" class="text-muted">&amp; up</span>
                  <% else %>
                    <%= label %>
                  <% end %>
                </label>
              <% end %>
            </fieldset>
          </div>

          <div class="flex shrink-0 gap-3 border-t border-divider p-4 lg:hidden">
            <%= link_to "Clear all", products_path(**@listing_params.slice(:query, :category)), class: "btn-secondary flex-1 border-line" %>
            <button type="submit" class="btn-primary flex-[2]">Show results</button>
          </div>
        <% end %>
      </dialog>
    </div>

      <div class="min-w-0">
        <div class="mb-5 flex flex-wrap items-center gap-3 border-b border-divider pb-5">
          <button type="button" class="btn-secondary border-line lg:hidden" data-action="drawer#open" aria-controls="filters" aria-haspopup="dialog">
            <%= icon(:sliders, css_class: "size-[18px]") %> Filters
            <% if active_filters.any? %><span class="flex size-5 items-center justify-center rounded-full bg-brand-strong text-[11px] text-white tabular-nums"><%= active_filters.size %></span><% end %>
          </button>

          <p class="hidden text-sm text-muted tabular-nums lg:block">
            <% if @pagy.count.positive? %>Showing <%= @pagy.from %>&ndash;<%= @pagy.to %> of <%= @pagy.count %><% end %>
          </p>

          <div class="ml-auto flex items-center gap-3">
            <%= form_with url: products_path, method: :get, data: { controller: "auto-submit" }, class: "flex items-center gap-2" do |f| %>
              <% @listing_params.except(:sort).each do |key, value| %>
                <%= hidden_field_tag key, value, id: nil %>
              <% end %>
              <%= f.label :sort, "Sort by", class: "hidden text-sm text-muted sm:block" %>
              <%= f.select :sort, options_for_select(sort_options, @sort), {},
                    data: { action: "auto-submit#submit" }, "aria-label": "Sort by",
                    class: "input h-11 w-auto cursor-pointer pr-9 text-sm font-medium" %>
              <noscript><%= f.submit "Apply", name: nil, class: "btn-secondary" %></noscript>
            <% end %>

            <div class="hidden overflow-hidden rounded-btn border border-line bg-surface sm:flex" role="group" aria-label="Layout">
              <% [ [ "grid", :grid, "Grid view" ], [ "list", :list, "List view" ] ].each do |view, icon_name, label| %>
                <%= link_to products_path(**@listing_params.except(:view), view: (view unless view == "grid")),
                      "aria-label": label, "aria-current": (@view == view ? "true" : nil),
                      class: "flex size-11 items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand #{@view == view ? 'selected' : 'text-muted hover:bg-subtle hover:text-ink'}" do %>
                  <%= icon(icon_name, css_class: "size-[18px]") %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <% if active_filters.any? %>
          <ul class="mb-6 flex flex-wrap items-center gap-2" aria-label="Active filters">
            <% active_filters.each do |label, keys| %>
              <li>
                <%= link_to products_path(**@listing_params.except(*Array(keys))),
                      class: "inline-flex min-h-9 items-center gap-1.5 rounded-full bg-surface py-1 pl-3.5 pr-2 text-sm font-medium text-ink ring-1 ring-line transition-colors hover:ring-ink/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand",
                      "aria-label": "Remove filter: #{label}" do %>
                  <%= label %> <%= icon(:close, css_class: "size-3.5 text-muted") %>
                <% end %>
              </li>
            <% end %>
            <li><%= link_to "Clear all", products_path, class: "link px-2 text-sm" %></li>
          </ul>
        <% end %>

        <% if @products.any? %>
          <h2 class="sr-only">Products</h2>
          <% if @view == "list" %>
            <div class="space-y-3">
              <% @products.each do |product| %>
                <%= render "product_row", product: product, in_bag_quantity: @bag_quantities[product.id], wishlist_item_id: @wishlist_ids[product.id] %>
              <% end %>
            </div>
          <% else %>
            <%= render "grid", products: @products, bag_quantities: @bag_quantities, wishlist_ids: @wishlist_ids, layout: :listing %>
          <% end %>
          <%= render "pagination", pagy: @pagy %>
        <% elsif @query.present? %>
          <%= render "shared/empty_state", icon: :search,
                title: "Nothing matches “#{@query}”",
                body: "Try a shorter or different word, or remove a filter.",
                action_label: "Clear search",
                action_path: products_path(**@listing_params.except(:query)) %>
        <% elsif active_filters.any? %>
          <%= render "shared/empty_state", icon: :sliders,
                title: "No products match these filters",
                body: "Try widening the price range or removing a filter.",
                action_label: "Clear filters",
                action_path: products_path %>
        <% else %>
          <%= render "shared/empty_state", icon: :grid,
                title: "No products yet",
                body: "The catalog is empty right now. Check back soon." %>
        <% end %>
      </div>
  </div>
<% end %>
