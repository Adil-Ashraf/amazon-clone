<% content_for :title, @query.present? ? "Search: #{@query}" : (@selected_category&.name || "All Products") %>

<div class="flex flex-col md:flex-row gap-6">
  <aside class="md:w-56 shrink-0">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Categories</h2>
    <ul class="flex md:flex-col gap-2 md:gap-1 overflow-x-auto md:overflow-visible -mx-4 px-4 md:mx-0 md:px-0 pb-2 md:pb-0">
      <li class="shrink-0">
        <%= link_to products_path(query: @query.presence), data: { turbo_frame: "products_results" },
              class: "flex items-center gap-2 px-3 py-1.5 rounded-full md:rounded whitespace-nowrap text-sm #{@selected_category ? 'text-gray-700 hover:bg-gray-100 bg-gray-100 md:bg-transparent' : 'bg-slate-900 text-white'}" do %>
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="8" height="8" rx="1"/>
            <rect x="13" y="3" width="8" height="8" rx="1"/>
            <rect x="3" y="13" width="8" height="8" rx="1"/>
            <rect x="13" y="13" width="8" height="8" rx="1"/>
          </svg>
          All Products
        <% end %>
      </li>
      <% @categories.each do |category| %>
        <li class="shrink-0">
          <%= link_to products_path(category: category.slug, query: @query.presence), data: { turbo_frame: "products_results" },
                class: "flex items-center gap-2 px-3 py-1.5 rounded-full md:rounded whitespace-nowrap text-sm #{@selected_category == category ? 'bg-slate-900 text-white' : 'text-gray-700 hover:bg-gray-100 bg-gray-100 md:bg-transparent'}" do %>
            <%= category_icon(category, css_class: "w-4 h-4 shrink-0") %>
            <%= category.name %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </aside>

  <div class="flex-1">
    <%= turbo_frame_tag "products_results", data: { turbo_action: "advance" } do %>
      <div class="mb-4 flex items-center justify-between flex-wrap gap-2">
        <h1 class="text-xl font-semibold text-gray-900">
          <% if @query.present? %>
            Search results for &ldquo;<%= @query %>&rdquo;
          <% else %>
            <%= @selected_category&.name || "All Products" %>
          <% end %>
        </h1>
        <p class="text-sm text-gray-500"><%= pluralize(@products.size, "product") %></p>
      </div>

      <% if @products.any? %>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
          <% @products.each do |product| %>
            <%= render "product_card", product: product %>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded shadow p-10 text-center text-gray-600">
          <% if @query.present? %>
            <p class="mb-3">No products found for &ldquo;<%= @query %>&rdquo;.</p>
            <%= link_to "Clear search", products_path(category: @selected_category&.slug), class: "text-blue-600 hover:underline" %>
          <% elsif @selected_category %>
            <p class="mb-3">No products in <%= @selected_category.name %> yet.</p>
            <%= link_to "Browse all products", products_path, class: "text-blue-600 hover:underline" %>
          <% else %>
            <p>No products available.</p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
