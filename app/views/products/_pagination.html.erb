<% if pagy.last > 1 %>
  <nav class="mt-12 flex flex-wrap items-center justify-center gap-1" aria-label="Pagination">
    <% if pagy.previous %>
      <%= link_to pagy.page_url(:previous), class: "btn-tertiary min-w-11 px-3", "aria-label": "Previous page" do %>
        <%= icon(:chevron_left, css_class: "size-4") %><span class="hidden sm:inline">Previous</span>
      <% end %>
    <% else %>
      <span class="btn-tertiary min-w-11 px-3" aria-disabled="true"><%= icon(:chevron_left, css_class: "size-4") %><span class="hidden sm:inline">Previous</span></span>
    <% end %>

    <% (1..pagy.last).each do |page_number| %>
      <% if page_number == pagy.page %>
        <span class="btn selected min-w-11 px-0 tabular-nums" aria-current="page"><%= page_number %></span>
      <% else %>
        <%= link_to page_number, pagy.page_url(page_number), class: "btn-tertiary min-w-11 px-0 tabular-nums", "aria-label": "Page #{page_number}" %>
      <% end %>
    <% end %>

    <% if pagy.next %>
      <%= link_to pagy.page_url(:next), class: "btn-tertiary min-w-11 px-3", "aria-label": "Next page" do %>
        <span class="hidden sm:inline">Next</span><%= icon(:chevron_right, css_class: "size-4") %>
      <% end %>
    <% else %>
      <span class="btn-tertiary min-w-11 px-3" aria-disabled="true"><span class="hidden sm:inline">Next</span><%= icon(:chevron_right, css_class: "size-4") %></span>
    <% end %>
  </nav>
<% end %>
