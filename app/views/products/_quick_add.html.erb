<%# locals: (product:, in_bag_quantity:) %>
<div id="<%= dom_id(product, :quick_add) %>" class="shrink-0">
  <% if product.out_of_stock? %>
    <button type="button" disabled class="btn-secondary px-3">Sold out</button>
  <% elsif in_bag_quantity.to_i.positive? %>
    <%= link_to "In bag · #{in_bag_quantity}", cart_path, data: { turbo_frame: "_top" }, class: "btn-secondary px-3" %>
  <% else %>
    <%# _top so a guest's sign-in redirect replaces the page, not the catalog frame;
        Turbo Stream responses still apply in place. %>
    <%= button_to "Add", cart_items_path,
          params: { product_id: product.id, quantity: 1 },
          form: { data: { turbo_frame: "_top" } },
          data: { turbo_submits_with: "Adding…" },
          "aria-label": "Add #{product.name} to bag",
          class: "btn-primary px-3" %>
  <% end %>
</div>
