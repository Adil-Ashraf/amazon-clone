<%# locals: (product:, in_bag_quantity:) %>
<%# Class, not id: the same product can be on a page more than once (home
    page rails), and the create stream replaces every copy. %>
<div class="<%= dom_id(product, :quick_add) %>">
  <% if product.out_of_stock? %>
    <button type="button" disabled class="btn-secondary w-full">Sold out</button>
  <% elsif in_bag_quantity.to_i.positive? %>
    <%= link_to cart_path, data: { turbo_frame: "_top" }, class: "btn-secondary w-full border-line" do %>
      <%= icon(:check, css_class: "size-4 text-success", stroke_width: 2.25) %> In cart &middot; <%= in_bag_quantity %>
    <% end %>
  <% else %>
    <%# _top so a guest's sign-in redirect replaces the page, not the catalog frame;
        Turbo Stream responses still apply in place. %>
    <%= button_to cart_items_path,
          params: { product_id: product.id, quantity: 1 },
          form: { data: { turbo_frame: "_top" } },
          data: { turbo_submits_with: "Adding…" },
          class: "btn-card w-full px-3 text-sm sm:text-[15px]" do %>
      <%# The visible words start the accessible name, so voice control's "Add to Cart" works. %>
      Add to Cart<span class="sr-only">: <%= product.name %></span>
    <% end %>
  <% end %>
</div>
