<%# locals: (product:, in_bag_quantity:, wishlist_item_id:, image_loading: "lazy") %>
<article class="group relative flex flex-col rounded-xl border border-line bg-surface transition-[transform,box-shadow,border-color] duration-200 motion-safe:hover:-translate-y-0.5 hover:border-ink/15 hover:shadow-lift">
  <div class="relative aspect-square overflow-hidden rounded-t-xl bg-subtle">
    <%# Duplicate of the name link below, so it's hidden from keyboard and screen readers. %>
    <%= link_to product_path(product), data: { turbo_frame: "_top" }, tabindex: -1, "aria-hidden": "true", class: "block size-full" do %>
      <%= product_image_tag product, loading: image_loading,
            css_class: "motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.04]" %>
    <% end %>
    <div class="absolute left-2 top-2">
      <%= render "products/wishlist_toggle", product: product, wishlist_item_id: wishlist_item_id %>
    </div>
    <% if product.on_sale? %>
      <div class="absolute right-3 top-3"><%= discount_badge(product) %></div>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <p class="truncate text-[11px] font-medium uppercase tracking-wider text-muted sm:text-xs"><%= product.category.name %></p>
    <h3 class="mt-1.5 text-sm leading-snug font-medium sm:text-[15px]">
      <%= link_to product.name, product_path(product), data: { turbo_frame: "_top" },
            class: "line-clamp-2 rounded text-ink hover:text-brand-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" %>
    </h3>
    <div class="mt-2"><%= rating_summary(product) %></div>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
      <%= price_tag(product) %>
      <% if product.out_of_stock? || product.low_stock? %><%= stock_badge(product) %><% end %>
    </div>
    <div class="mt-auto pt-4">
      <%= render "products/quick_add", product: product, in_bag_quantity: in_bag_quantity %>
    </div>
  </div>
</article>
