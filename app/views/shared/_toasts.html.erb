<div id="toasts" aria-live="polite"
     class="pointer-events-none fixed inset-x-4 bottom-4 z-50 flex flex-col gap-2 sm:inset-x-auto sm:bottom-auto sm:right-6 sm:top-24 sm:w-96 lg:top-36">
  <% if notice.present? %>
    <%= render "shared/toast", variant: :success, message: notice %>
  <% end %>
  <% if alert.present? %>
    <%= render "shared/toast", variant: :error, message: alert %>
  <% end %>
</div>
