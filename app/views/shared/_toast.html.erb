<%# locals: (variant:, message:, timeout: variant == :success ? 4000 : 0, action_label: nil, action_path: nil) %>
<div data-controller="dismissible" data-dismissible-timeout-value="<%= timeout %>"
     role="<%= variant == :error ? "alert" : "status" %>"
     class="toast pointer-events-auto flex w-full items-center gap-3 rounded-xl border border-line bg-surface py-2 pl-4 pr-2 text-sm font-medium text-ink shadow-float">
  <% if variant == :success %>
    <%= icon(:check_circle, css_class: "size-5 shrink-0 text-success") %>
  <% else %>
    <%= icon(:alert_circle, css_class: "size-5 shrink-0 text-danger") %>
  <% end %>
  <p class="flex-1 py-1.5"><%= message %></p>
  <% if action_label && action_path %>
    <%= link_to action_label, action_path, data: { turbo_frame: "_top" }, class: "link shrink-0 px-1" %>
  <% end %>
  <button type="button" data-action="dismissible#close" aria-label="Dismiss" class="icon-btn -my-1 text-muted">
    <%= icon(:close, css_class: "size-4") %>
  </button>
</div>
