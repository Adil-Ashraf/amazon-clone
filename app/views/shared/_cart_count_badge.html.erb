      class="<%= cart_item_count.zero? ? "hidden" : "inline-flex" %> min-w-5 h-5 items-center justify-center rounded-full bg-ink px-1.5 text-xs font-semibold tabular-nums text-surface">
  <%= cart_item_count %><span class="sr-only"> items in bag</span>
</span>
