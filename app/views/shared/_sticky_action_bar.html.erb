<%# locals: (label:, amount_cents:, hidden_from:) %>
<%# The main action pinned to the bottom of small screens (product page, cart).
    hidden_from is the first breakpoint where it hides (:md or :lg); the page
    reserves room for it while it shows (application.css), so it never covers
    the end of the page. The caller yields the action button. %>
<div class="sticky-action-bar fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur <%= { md: "md:hidden", lg: "lg:hidden" }.fetch(hidden_from) %>"
     data-hidden-from="<%= hidden_from %>">
  <div class="flex items-center gap-4">
    <div class="min-w-0 flex-1">
      <p class="truncate text-xs text-muted"><%= label %></p>
      <p class="price text-lg"><%= format_price_cents(amount_cents) %></p>
    </div>
    <%= yield %>
  </div>
</div>
