<%
  on_listing = controller_name == "products" && action_name == "index"
  nav_items = [
    [ "Shop", products_path, on_listing && params.slice(:category, :deals, :sort).values.all?(&:blank?) ],
    [ "Deals", products_path(deals: 1), on_listing && params[:deals] == "1" ],
    [ "New arrivals", products_path(sort: "newest"), on_listing && params[:sort] == "newest" && params[:category].blank? ]
  ]
  # On the catalog, header search updates the results frame as you type
  # (live_search_controller.js); elsewhere it's a normal GET search.
  live_search_form = on_listing ? {
    controller: "live-search", live_search_frame_value: "products_results",
    action: "submit->live-search#submit turbo:frame-load@document->live-search#frameLoaded"
  } : {}
  live_search_input = on_listing ? { live_search_target: "input", action: "input->live-search#search blur->live-search#blur" } : {}
  nav_link_class = ->(active) {
    "relative flex h-12 items-center rounded text-sm font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand " +
      (active ? "text-ink after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:rounded-full after:bg-brand" : "text-muted hover:text-ink")
  }
%>
<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/85"
        data-controller="drawer">
  <div class="page flex h-16 items-center gap-2 lg:h-[76px] lg:gap-8">
    <button type="button" class="icon-btn -ml-2.5 lg:hidden" data-action="drawer#open"
            aria-label="Open menu" aria-controls="mobile_nav" aria-haspopup="dialog">
      <%= icon(:menu, css_class: "size-6") %>
    </button>

    <%= render "shared/logo" %>

    <%= form_with url: products_path, method: :get, role: "search", data: live_search_form,
          class: "hidden flex-1 md:block lg:max-w-2xl lg:mx-auto" do |f| %>
      <%= f.label :query, "Search products, brands and more", class: "sr-only" %>
      <div class="relative">
        <%= icon(:search, css_class: "pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-muted") %>
        <%= f.search_field :query,
              value: params[:query],
              placeholder: "Search products, brands and more...",
              autocomplete: "off",
              data: live_search_input,
              class: "input h-12 rounded-full border-line bg-bg pl-12 pr-28 hover:border-line focus:bg-surface" %>
        <button type="submit" class="btn-primary absolute right-0.5 top-1/2 min-h-11 -translate-y-1/2 rounded-full px-5 text-sm">Search</button>
      </div>
      <% if on_listing %><span class="sr-only" role="status" data-live-search-target="status"></span><% end %>
    <% end %>

    <nav class="ml-auto flex items-center gap-0.5 md:ml-0 lg:gap-1" aria-label="Account">
      <div data-controller="menu"
           data-action="click@window->menu#closeOnOutsideClick keydown.esc@window->menu#closeOnEscape"
           class="md:hidden">
        <button type="button" class="icon-btn" aria-label="Search" aria-expanded="false"
                aria-controls="mobile_search" data-menu-target="button" data-action="menu#toggle">
          <%= icon(:search, css_class: "size-[22px]") %>
        </button>
        <div id="mobile_search" hidden data-menu-target="panel"
             class="absolute inset-x-0 top-full border-b border-line bg-surface px-4 py-3 shadow-float">
          <%= form_with url: products_path, method: :get, role: "search", data: live_search_form do |f| %>
            <%= f.label :query, "Search products, brands and more", class: "sr-only", for: "mobile_query" %>
            <div class="relative">
              <%= icon(:search, css_class: "pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-muted") %>
              <%= f.search_field :query, id: "mobile_query", value: params[:query],
                    placeholder: "Search products, brands and more...", autocomplete: "off",
                    data: { menu_target: "focus", **live_search_input },
                    class: "input rounded-full bg-bg pl-12" %>
            </div>
            <% if on_listing %><span class="sr-only" role="status" data-live-search-target="status"></span><% end %>
          <% end %>
        </div>
      </div>

      <%= link_to orders_path, class: "btn-tertiary hidden gap-2 px-3 lg:inline-flex" do %>
        <%= icon(:package) %><span class="text-sm font-medium">Orders</span>
      <% end %>
      <%= link_to wishlist_items_path, class: "btn-tertiary hidden gap-2 px-3 md:inline-flex", "aria-label": "Wishlist" do %>
        <%= icon(:heart) %><span class="hidden text-sm font-medium lg:inline">Wishlist</span>
      <% end %>

      <% if logged_in? %>
        <div data-controller="menu"
             data-action="click@window->menu#closeOnOutsideClick keydown.esc@window->menu#closeOnEscape"
             class="relative hidden md:block">
          <button type="button" class="btn-tertiary gap-2 px-3"
                  aria-expanded="false" aria-controls="account_menu" aria-haspopup="true"
                  data-menu-target="button" data-action="menu#toggle">
            <%= icon(:user) %>
            <span class="hidden text-sm font-medium lg:inline">Account</span>
            <span class="sr-only">menu</span>
            <%= icon(:chevron_down, css_class: "hidden size-4 text-muted lg:block") %>
          </button>

          <div id="account_menu" hidden data-menu-target="panel"
               class="absolute right-0 z-50 mt-2 w-72 rounded-2xl border border-line bg-surface p-2 shadow-float">
            <div class="px-3 pt-2 pb-3">
              <p class="text-xs text-muted">Signed in as</p>
              <p class="truncate text-sm font-semibold text-ink"><%= current_user.email %></p>
            </div>
            <div class="border-t border-divider py-1.5">
              <% [ [ "My Account", account_path, :user ], [ "Orders", orders_path, :package ],
                   [ "Wishlist", wishlist_items_path, :heart ], [ "Addresses", account_path(anchor: "addresses"), :map_pin ] ].each do |label, path, icon_name| %>
                <%= link_to path, class: "btn-tertiary w-full justify-start gap-3 px-3 font-medium" do %>
                  <%= icon(icon_name, css_class: "size-[18px] text-muted") %><%= label %>
                <% end %>
              <% end %>
            </div>
            <div class="border-t border-divider pt-1.5">
              <%= button_to session_path, method: :delete, form_class: "w-full",
                    data: { turbo_submits_with: "Signing out…" },
                    class: "btn-tertiary w-full justify-start gap-3 px-3 font-medium" do %>
                <%= icon(:log_out, css_class: "size-[18px] text-muted") %>Sign out
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <%= link_to new_session_path, class: "btn-tertiary hidden gap-2 px-3 md:inline-flex" do %>
          <%= icon(:user) %><span class="text-sm font-medium">Sign in</span>
        <% end %>
      <% end %>

      <%= link_to cart_path, class: "btn-tertiary relative -mr-2 gap-2 px-2.5 md:mr-0 md:px-3", "aria-label": "Cart" do %>
        <span class="relative inline-flex p-0.5">
          <%= icon(:cart, css_class: "size-[22px]") %>
          <%= render "shared/cart_count_badge" %>
        </span>
        <span class="hidden text-sm font-medium lg:inline" aria-hidden="true">Cart</span>
      <% end %>
    </nav>
  </div>

  <div class="hidden border-t border-divider lg:block">
    <nav class="page flex items-center gap-7" aria-label="Shop">
      <% nav_items.each do |label, path, active| %>
        <%= link_to label, path, class: nav_link_class.(active), "aria-current": (active ? "page" : nil) %>
      <% end %>

      <div data-controller="menu" class="relative"
           data-action="click@window->menu#closeOnOutsideClick keydown.esc@window->menu#closeOnEscape">
        <button type="button" class="<%= nav_link_class.(false) %> cursor-pointer gap-1"
                aria-expanded="false" aria-controls="categories_menu" data-menu-target="button" data-action="menu#toggle">
          Categories <%= icon(:chevron_down, css_class: "size-4") %>
        </button>
        <div id="categories_menu" hidden data-menu-target="panel"
             class="absolute left-0 top-full z-10 mt-1 grid w-[440px] grid-cols-2 gap-1 rounded-2xl border border-line bg-surface p-2 shadow-float">
          <% nav_categories.sort_by(&:name).each do |category| %>
            <%= link_to products_path(category: category.slug),
                  class: "flex min-h-11 items-center gap-3 rounded-btn px-3 text-sm font-medium text-ink hover:bg-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" do %>
              <span class="flex size-8 items-center justify-center rounded-full bg-subtle text-muted"><%= category_icon(category, css_class: "size-4") %></span>
              <%= category.name %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% nav_categories.first(5).each do |category| %>
        <% active = on_listing && params[:category] == category.slug %>
        <%= link_to category.name, products_path(category: category.slug),
              class: nav_link_class.(active), "aria-current": (active ? "page" : nil) %>
      <% end %>

      <%= link_to "Help", page_path("help"), class: nav_link_class.(current_page?(page_path("help"))) %>

      <%= link_to page_path("sell"), class: "ml-auto flex h-12 items-center gap-1.5 rounded text-sm font-medium text-ink hover:text-brand-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" do %>
        Sell on Aisle Market <%= icon(:arrow_right, css_class: "size-4") %>
      <% end %>
    </nav>
  </div>

  <%= render "shared/mobile_nav", nav_items: nav_items %>
</header>
