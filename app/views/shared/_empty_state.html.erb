<%# locals: (icon:, title:, body:, action_label: nil, action_path: nil) %>
<div class="card flex flex-col items-center px-6 py-14 text-center sm:py-20">
  <span class="mb-5 flex size-16 items-center justify-center rounded-full bg-brand-soft text-brand-strong">
    <%= icon(icon, css_class: "size-7", stroke_width: 1.5) %>
  </span>
  <h2 class="h3"><%= title %></h2>
  <p class="mt-2 max-w-sm text-[15px] text-muted"><%= body %></p>
  <% if action_label && action_path %>
    <%= link_to action_path, data: { turbo_frame: "_top" }, class: "btn-primary btn-lg mt-8" do %>
      <%= action_label %> <%= icon(:arrow_right, css_class: "size-4") %>
    <% end %>
  <% end %>
</div>
