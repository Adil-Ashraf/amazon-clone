<%# locals: (title:, id:, eyebrow: nil, subtitle: nil, link_label: nil, link_path: nil) %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2 lg:mb-8">
  <div>
    <% if eyebrow %><p class="eyebrow mb-2"><%= eyebrow %></p><% end %>
    <h2 id="<%= id %>" class="h2"><%= title %></h2>
    <% if subtitle %><p class="mt-2 text-[15px] text-muted"><%= subtitle %></p><% end %>
  </div>
  <% if link_label && link_path %>
    <%= link_to link_path, class: "group inline-flex min-h-11 items-center gap-1.5 rounded text-[15px] font-semibold text-ink hover:text-brand-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand" do %>
      <%= link_label %>
      <%= icon(:arrow_right, css_class: "size-4 transition-transform duration-200 group-hover:translate-x-0.5") %>
    <% end %>
  <% end %>
</div>
