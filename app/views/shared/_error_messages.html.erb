<% if object.errors.any? %>
  <div role="alert" class="mb-6 flex gap-3 rounded-xl border border-danger/20 bg-danger-soft px-4 py-3 text-sm text-danger">
    <%= icon(:alert_circle, css_class: "mt-0.5 size-5 shrink-0") %>
    <div>
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-1 list-disc space-y-0.5 pl-4">
        <% object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
