<%= render layout: "shell", locals: { title: "Privacy", intro: "What we store, and why." } do %>
  <section><h2>Your data</h2>
    <p>We store your name, email and a hashed password to run your account, plus the orders, reviews and wishlist items you create. Newsletter sign-ups store only an email address.</p></section>
  <section><h2 id="cookies">Cookies</h2>
    <p>We use one session cookie to keep you signed in and to remember recently viewed products. No advertising or tracking cookies.</p></section>
<% end %>
