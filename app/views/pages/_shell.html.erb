<%# locals: (title:, intro:) %>
<% content_for :title, title %>
<div class="page py-10 lg:py-16">
  <div class="mx-auto max-w-3xl">
    <p class="eyebrow">Aisle Market</p>
    <h1 class="page-title mt-3"><%= title %></h1>
    <p class="mt-4 text-[17px] leading-relaxed text-muted"><%= intro %></p>
    <div class="mt-10 space-y-10 text-base leading-relaxed text-ink/85 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-ink [&_h2]:scroll-mt-40 [&_p+p]:mt-3 [&_h2+p]:mt-3">
      <%= yield %>
    </div>
    <div class="mt-12 rounded-2xl border border-line bg-surface p-6">
      <p class="font-semibold">Still need help?</p>
      <p class="mt-1 text-[15px] text-muted">This is a demo store, so there&rsquo;s no support team on the other end. The <%= link_to "help page", page_path("help"), class: "link" %> covers how everything works.</p>
    </div>
  </div>
</div>
