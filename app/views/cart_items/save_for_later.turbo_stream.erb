<%= render "sync" %>

<%= turbo_stream.replace "saved_items" do %>
  <%= render "carts/saved_items", saved_items: @saved_items %>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <%= render "shared/toast", variant: :success, message: "Saved to your wishlist", action_label: "View wishlist", action_path: wishlist_items_path %>
<% end %>
