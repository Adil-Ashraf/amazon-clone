<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Amazon Clone" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Amazon Clone">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "icon.svg", type: "image/svg+xml" %>
    <%= favicon_link_tag "icon.png", rel: "apple-touch-icon" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <header class="bg-slate-900 text-white">
      <div class="container mx-auto px-4 py-3 flex flex-wrap items-center gap-3">
        <%= link_to root_path, class: "text-xl font-bold text-white whitespace-nowrap shrink-0" do %>
          AmazonClone
        <% end %>

        <%= form_with url: products_path, method: :get, class: "flex flex-1 min-w-[200px] order-3 sm:order-none",
              data: live_search? ? {
                controller: "live-search",
                turbo_frame: "products_results",
                live_search_frame_value: "products_results",
                live_search_url_value: products_path
              } : {} do |f| %>
          <%= f.text_field :query,
                value: params[:query],
                placeholder: "Search products...",
                "aria-label": "Search products",
                autocomplete: "off",
                data: live_search? ? { live_search_target: "input", action: "input->live-search#search" } : {},
                class: "flex-1 rounded-l px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-400" %>
          <%= f.submit "Search", class: "bg-amber-400 text-slate-900 px-4 rounded-r font-semibold hover:bg-amber-300 cursor-pointer" %>
        <% end %>

        <nav class="flex items-center gap-3 flex-wrap ml-auto" aria-label="Account">
          <% if logged_in? %>
            <span class="text-sm hidden sm:inline">Hello, <%= current_user.name %></span>
            <%= link_to "Orders", orders_path, class: "text-sm hover:underline" %>
            <%= button_to "Sign Out", session_path, method: :delete,
                  data: { turbo_submits_with: "Signing Out..." },
                  class: "text-sm font-medium border border-white/50 text-white hover:bg-white/10 rounded px-3 py-1.5 cursor-pointer" %>
          <% else %>
            <%= link_to "Sign In", new_session_path,
                  class: "text-sm font-medium border border-white/50 text-white hover:bg-white/10 rounded px-3 py-1.5" %>
            <%= link_to "Sign Up", new_registration_path,
                  class: "text-sm font-semibold bg-amber-400 hover:bg-amber-300 text-slate-900 rounded px-3 py-1.5" %>
          <% end %>

          <%= link_to cart_path, class: "relative flex items-center hover:opacity-80", "aria-label": "Cart" do %>
            <span class="text-2xl leading-none" aria-hidden="true">🛒</span>
            <%= render "shared/cart_count_badge" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container mx-auto mt-6 px-4">
      <% if notice.present? %>
        <p class="mb-4 rounded bg-green-100 text-green-800 px-4 py-2"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="mb-4 rounded bg-red-100 text-red-800 px-4 py-2"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
