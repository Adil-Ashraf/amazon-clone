<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} — Aisle Market" : "Aisle Market — Better products. Better everyday." %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Aisle Market: quality products for your home, work and lifestyle, all in one place.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Aisle Market">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#F8F6F2">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

    <%# PNG first for browsers without SVG favicons; SVG last so the rest prefer it. %>
    <%= favicon_link_tag "icon.png", type: "image/png", sizes: "512x512" %>
    <%= favicon_link_tag "icon.svg", type: "image/svg+xml" %>
    <%= favicon_link_tag "icon.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-bg font-sans text-base text-ink antialiased">
    <a href="#main"
       class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] btn-primary">
      Skip to content
    </a>

    <%= content_for?(:header) ? yield(:header) : render("shared/header") %>

    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <%= yield %>
    </main>

    <%= content_for?(:footer) ? yield(:footer) : render("shared/footer") %>
    <%= render "shared/toasts" %>
  </body>
</html>
