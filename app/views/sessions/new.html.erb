<% content_for :title, "Sign In" %>

<div class="max-w-sm mx-auto bg-white rounded shadow p-6">
  <h1 class="text-2xl font-semibold mb-4">Sign In</h1>

  <%= form_with url: session_path, method: :post do |f| %>
    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, required: true, autofocus: true,
            class: "w-full rounded border-gray-300 px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true,
            class: "w-full rounded border-gray-300 px-3 py-2" %>
    </div>

    <%= f.submit "Sign In", data: { turbo_submits_with: "Signing In..." },
          class: "w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold py-2 rounded cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-sm text-gray-600">
    New here? <%= link_to "Create an account", new_registration_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
