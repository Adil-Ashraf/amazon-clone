<% content_for :title, "Sign in" %>
<% invalid = @sign_in_error.present? %>

<%= render layout: "shared/auth_shell", locals: { showcase: @showcase } do %>
  <h1 class="page-title">Welcome back</h1>
  <p class="mt-2 text-[15px] text-muted">Sign in to see your cart, orders and wishlist.</p>

  <%= form_with url: session_path, method: :post, class: "mt-8 space-y-5" do |f| %>
    <% if invalid %>
      <div id="sign_in_error" role="alert" class="flex gap-3 rounded-xl border border-danger/20 bg-danger-soft px-4 py-3 text-sm text-danger">
        <%= icon(:alert_circle, css_class: "mt-0.5 size-5 shrink-0") %>
        <p><span class="font-semibold">We couldn&rsquo;t sign you in.</span> <%= @sign_in_error %></p>
      </div>
    <% end %>
    <div>
      <%= f.label :email, "Email", class: "label" %>
      <%= f.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "email", class: "input",
            "aria-invalid": (invalid ? "true" : nil), "aria-describedby": (invalid ? "sign_in_error" : nil) %>
    </div>
    <div>
      <div class="mb-2 flex items-center justify-between">
        <%= f.label :password, "Password", class: "text-sm font-medium" %>
        <%= link_to "Forgot password?", page_path("help", anchor: "account"), class: "link text-sm" %>
      </div>
      <%= f.password_field :password, required: true, autocomplete: "current-password", class: "input",
            "aria-invalid": (invalid ? "true" : nil), "aria-describedby": (invalid ? "sign_in_error" : nil) %>
    </div>
    <%= f.submit "Sign In", data: { turbo_submits_with: "Signing in…" }, class: "btn-primary btn-lg w-full" %>
  <% end %>

  <div class="mt-6 rounded-xl bg-bg px-4 py-3 text-sm text-muted ring-1 ring-line">
    <p class="font-medium text-ink">Trying the demo?</p>
    <p class="mt-0.5">Sign in with <span class="font-medium text-ink">demo@example.com</span> / <span class="font-medium text-ink">password123</span></p>
  </div>

  <p class="mt-8 text-center text-[15px] text-muted">
    New to Aisle Market? <%= link_to "Create an account", new_registration_path, class: "link" %>
  </p>
<% end %>
