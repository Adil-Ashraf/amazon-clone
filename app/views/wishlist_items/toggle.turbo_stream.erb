<%= turbo_stream.replace_all ".#{dom_id(@product, :wishlist)}" do %>
  <%= render "products/wishlist_toggle", product: @product, wishlist_item_id: @wishlist_item&.id %>
<% end %>

<%# On the wishlist page the grid itself changes; on the cart page, the saved list. %>
<%= turbo_stream.replace "wishlist_items" do %>
  <%= render "wishlist_items/list", wishlist_items: @wishlist_items, bag_quantities: @bag_quantities, wishlist_ids: @wishlist_ids %>
<% end %>

<%= turbo_stream.replace "saved_items" do %>
  <%= render "carts/saved_items", saved_items: @wishlist_items %>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <%= render "shared/toast", variant: :success, message: @message, action_label: ("View wishlist" if @wishlist_item), action_path: (wishlist_items_path if @wishlist_item) %>
<% end %>
