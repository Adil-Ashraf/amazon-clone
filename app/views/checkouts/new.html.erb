<% content_for :title, "Checkout" %>

<h1 class="text-2xl font-semibold text-gray-900 mb-6">Checkout</h1>

<div class="grid md:grid-cols-3 gap-8">
  <div class="md:col-span-2">
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Shipping Address</h2>

    <%= render "shared/error_messages", object: @order %>

    <%= form_with model: @order, url: checkout_path, method: :post, class: card_classes("p-6 space-y-4") do |f| %>
      <div>
        <%= f.label :shipping_name, "Full Name", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :shipping_name, required: true, class: "w-full px-3 py-2 #{input_classes}" %>
      </div>

      <div>
        <%= f.label :shipping_address_line1, "Address Line 1", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :shipping_address_line1, required: true, class: "w-full px-3 py-2 #{input_classes}" %>
      </div>

      <div>
        <%= f.label :shipping_address_line2, "Address Line 2 (optional)", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :shipping_address_line2, class: "w-full px-3 py-2 #{input_classes}" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="sm:col-span-1">
          <%= f.label :shipping_city, "City", class: "block text-sm font-medium mb-1" %>
          <%= f.text_field :shipping_city, required: true, class: "w-full px-3 py-2 #{input_classes}" %>
        </div>
        <div>
          <%= f.label :shipping_state, "State", class: "block text-sm font-medium mb-1" %>
          <%= f.text_field :shipping_state, required: true, class: "w-full px-3 py-2 #{input_classes}" %>
        </div>
        <div>
          <%= f.label :shipping_zip, "ZIP", class: "block text-sm font-medium mb-1" %>
          <%= f.text_field :shipping_zip, required: true, class: "w-full px-3 py-2 #{input_classes}" %>
        </div>
      </div>

      <div class="border-t pt-4">
        <h2 class="text-lg font-semibold text-gray-900 mb-2">Payment</h2>
        <p class="text-sm text-gray-500 mb-4">
          This is a demo checkout &mdash; no real payment is processed. Clicking "Place Order" completes your order immediately.
        </p>
        <%= f.submit "Place Order", data: { turbo_submits_with: "Placing Order..." },
              class: "w-full bg-amber-400 hover:bg-amber-300 text-slate-900 font-semibold py-3 rounded cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div>
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Order Summary</h2>
    <div class="<%= card_classes("divide-y divide-gray-100 px-4") %>">
      <% @cart_items.each do |cart_item| %>
        <div class="flex justify-between gap-2 py-3 text-sm">
          <span class="text-gray-700"><%= cart_item.product.name %> &times; <%= cart_item.quantity %></span>
          <span class="font-medium text-gray-900 whitespace-nowrap"><%= format_price_cents(cart_item.product.price_cents * cart_item.quantity) %></span>
        </div>
      <% end %>
    </div>
    <div class="<%= card_classes("mt-4 p-4 flex items-center justify-between") %>">
      <span class="font-semibold text-gray-900">Total</span>
      <span class="text-xl font-bold text-gray-900"><%= format_price_cents(@cart.total_cents) %></span>
    </div>
  </div>
</div>
